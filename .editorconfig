# AdaptiveTimeStepper — https://editorconfig.org
# SPDX-License-Identifier: MIT
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml,json,md}]
indent_size = 2

[*.md]
# Two spaces at the end of a line are a line break in Markdown.
trim_trailing_whitespace = false

[*.{hpp,cpp}]
indent_size = 4

[CMakeLists.txt]
indent_size = 4
